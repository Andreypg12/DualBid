@section Scripts {
    <script>
        // Bootstrap carousel grande (el tuyo)
        const myCarouselElement = document.querySelector('#carruselHome');
        const carousel = new bootstrap.Carousel(myCarouselElement, {
            interval: 3500,
            pause: false,
            ride: 'carousel'
        });
    </script>

    <script>
        // Circle carousel (flechas + dots)
        (function () {
            const track = document.getElementById('ccTrack');
            const dotsWrap = document.getElementById('ccDots');
            const prev = document.querySelector('.cc-prev');
            const next = document.querySelector('.cc-next');

            if (!track || !dotsWrap || !prev || !next) return;

            const items = Array.from(track.querySelectorAll('.cc-item'));
            if (items.length === 0) return;

            function itemsPerView() {
                const itemW = items[0].getBoundingClientRect().width;
                const gap = parseFloat(getComputedStyle(track).gap) || 0;
                return Math.max(1, Math.floor(track.clientWidth / (itemW + gap)));
            }

            function pageCount() {
                return Math.ceil(items.length / itemsPerView());
            }

            function buildDots() {
                dotsWrap.innerHTML = '';
                const pages = pageCount();
                for (let i = 0; i < pages; i++) {
                    const b = document.createElement('button');
                    b.className = 'cc-dot';
                    b.type = 'button';
                    b.setAttribute('aria-label', `Go to page ${i + 1}`);
                    b.addEventListener('click', () => scrollToPage(i));
                    dotsWrap.appendChild(b);
                }
                setActiveDot();
            }

            function currentPageIndex() {
                const maxScroll = track.scrollWidth - track.clientWidth;
                if (maxScroll <= 0) return 0;
                return Math.round((track.scrollLeft / maxScroll) * (pageCount() - 1));
            }

            function setActiveDot() {
                const idx = currentPageIndex();
                const dots = Array.from(dotsWrap.querySelectorAll('.cc-dot'));
                dots.forEach((d, i) => d.classList.toggle('active', i === idx));
            }

            function scrollToPage(i) {
                const maxScroll = track.scrollWidth - track.clientWidth;
                const pages = pageCount();
                const target = pages <= 1 ? 0 : (maxScroll * (i / (pages - 1)));
                track.scrollTo({ left: target, behavior: 'smooth' });
            }

            function scrollByOnePage(dir) {
                track.scrollBy({ left: dir * track.clientWidth, behavior: 'smooth' });
            }

            prev.addEventListener('click', () => scrollByOnePage(-1));
            next.addEventListener('click', () => scrollByOnePage(1));
            track.addEventListener('scroll', () => requestAnimationFrame(setActiveDot));
            window.addEventListener('resize', buildDots);

            buildDots();
        })();
    </script>
}



