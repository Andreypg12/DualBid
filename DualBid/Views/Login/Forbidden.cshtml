@{
    Layout = null;
    ViewData["Title"] = "Acceso denegado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Libreria.Web</title>
    <!-- Bootstrap 5.3.8 -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/css/bootstrap.min.css"
          crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- SweetAlert2 (LibMan) -->
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Libreria.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-lg border-0 rounded-4 text-center overflow-hidden">
                    <div class="card-header border-0 py-4">
                        <div class="mb-3">
                            <i class="bi bi-shield-lock-fill display-1 text-warning"></i>
                        </div>
                        <h1 class="h3 mb-2">Acceso denegado</h1>
                        <p class="text-light-emphasis mb-0">
                            No cuenta con permisos suficientes para ingresar a esta sección.
                        </p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <div class="alert alert-warning d-flex align-items-start text-start" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
                            <div>
                                <strong>Acción restringida.</strong><br />
                                Su usuario ha iniciado sesión correctamente, pero su rol no tiene autorización para acceder a este recurso.
                            </div>
                        </div>

                        <p class="mb-4 text-muted">
                            Puede regresar a la página anterior, ir al inicio del sistema o cerrar sesión si desea ingresar con otra cuenta.
                        </p>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a href="javascript:history.back()" class="btn btn-outline-light">
                                <i class="bi bi-arrow-left-circle me-2"></i>Regresar
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                                <i class="bi bi-house-door-fill me-2"></i>Ir al inicio
                            </a>
                            <a asp-controller="Login" asp-action="LogOff" class="btn btn-danger">
                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                            </a>
                        </div>
                    </div>

                    <div class="card-footer border-0 py-3">
                        <small class="text-muted">Seguridad del sistema Librería Web</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- SweetAlert -->
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.js"></script>
    @if (TempData["Notificacion"] != null || ViewBag.Notificacion != null)
    {
        var notificacion = TempData["Notificacion"] ?? ViewBag.Notificacion;
        <script type="text/javascript">

            const payload = @Html.Raw(notificacion);

            if (payload) {
                Swal.fire(payload);
            }
        </script>
    }
</body>
</html>