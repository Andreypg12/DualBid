@model DualBid.ViewModels.Login.ViewModelLogin
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5.3.8 -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- SweetAlert2 (LibMan) -->
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DualBid.styles.css" asp-append-version="true" />

</head>
<body>
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header text-center py-4 border-0">
                        <div class="mb-3">
                            <i class="bi bi-person-circle display-4"></i>
                        </div>
                        <h2 class="h3 mb-1">Login</h2>
                        <p class="text-light-emphasis mb-0">
                            Enter your credentials to access the system
                        </p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <form id="loginForm" asp-controller="Login" asp-action="LogIn" method="post" asp-antiforgery="true">
                            <div class="mb-3">
                                <label asp-for="User" class="form-label fw-semibold">User</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <input asp-for="User"
                                           class="form-control"
                                           type="text"
                                           placeholder="Enter your email"
                                           autocomplete="username" />
                                </div>
                                <span asp-validation-for="User" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input asp-for="Password"
                                           id="Password"
                                           class="form-control"
                                           type="password"
                                           placeholder="Enter your password"
                                           autocomplete="current-password" />
                                    <button class="btn btn-outline-light border"
                                            type="button"
                                            id="togglePassword"
                                            title="Show or hide password">
                                        <i class="bi bi-eye text-black"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            @if (ViewBag.Message != null)
                            {
                                <div class="alert alert-danger mt-3" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    @ViewBag.Message
                                </div>
                            }

                            <div class="d-grid mt-4">
                                <button id="btnLogin" class="btn btn-primary btn-lg" type="submit">
                                    <span id="btnText">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                                    </span>
                                    <span id="btnSpinner" class="d-none">
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        Validating...
                                    </span>
                                </button>
                            </div>

                            <div class="text-center mt-3">
                                <small class="text-muted">
                                    Please verify that your username and password are correct.
                                </small>
                            </div>

                            <div class="text-center mt-3">
                                <small class="text-muted">
                                    Don´t you have an account?
                                    <a asp-controller="Register" asp-action="Index" class="text-decoration-none">
                                        Create an account here
                                    </a>
                                </small>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer text-center border-0 py-3">
                        <small class="text-muted">DualBid System</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.getElementById("loginForm").addEventListener("submit", function () {
            const btn = document.getElementById("btnLogin");
            const btnText = document.getElementById("btnText");
            const btnSpinner = document.getElementById("btnSpinner");

            btn.disabled = true;
            btnText.classList.add("d-none");
            btnSpinner.classList.remove("d-none");
        });

        document.getElementById("togglePassword").addEventListener("click", function () {
            const passwordInput = document.getElementById("Password");
            const icon = this.querySelector("i");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                passwordInput.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    @if (TempData["Notificacion"] != null || ViewBag.Notificacion != null)
    {
        var notificacion = TempData["Notificacion"] ?? ViewBag.Notificacion;
        <script type="text/javascript">
            const payload = @Html.Raw(notificacion);
            if (payload) { Swal.fire(payload); }
        </script>
    }
</body>
</html>