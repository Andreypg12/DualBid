@model DualBid.Application.DTOs.UserStateDTO

@{
    var stateId = Model?.Id;
    var stateText = Model?.Description ?? "Unknown";
}

@switch (stateId)
{
    case 1:
        <span class="badge bg-success">
            <i class="bi bi-check-circle-fill"></i> @stateText
        </span>
        break;

    case 2:
        <span class="badge bg-secondary">
            <i class="bi bi-check-circle-fill"></i> @stateText
        </span>
        break;

    case 3:
        <span class="badge bg-danger">
            <i class="bi bi-lock-fill"></i> @stateText
        </span>
        break;

    default:
        <span class="badge bg-dark">
            <i class="bi bi-question-circle-fill"></i> @stateText
        </span>
        break;
}