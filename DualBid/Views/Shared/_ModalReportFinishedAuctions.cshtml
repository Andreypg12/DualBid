<!-- Views/Shared/_ModalReporteFinishedAuctions.cshtml -->
<div class="modal fade" id="modalReportFinished" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0" style="background: #2b1e3e;">
                <div>
                    <span class="badge mb-1" style="background:#e040fb; color:#2b1e3e;">★ FINISHED AUCTIONS</span>
                    <h5 class="modal-title text-white mb-0">Finished Auctions Report</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-medium">From</label>
                        <input type="date" id="finished-from" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-medium">To</label>
                        <input type="date" id="finished-to" class="form-control" />
                    </div>
                </div>
                <div id="err-finished" class="alert alert-danger py-2 small d-none"></div>
                <button class="btn w-100 text-white fw-bold" style="background:#2b1e3e;" onclick="generarReporteFinished()">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>Generate Report
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function generarReporteFinished() {
        const from = document.getElementById('finished-from').value;
        const to = document.getElementById('finished-to').value;
        const err = document.getElementById('err-finished');

        if ((from && !to) || (!from && to)) {
            err.textContent = 'Please complete both date fields.';
            err.classList.remove('d-none');
            return;
        }

        if (from && to && new Date(from) > new Date(to)) {
            err.textContent = 'The start date cannot be greater than the end date.';
            err.classList.remove('d-none');
            return;
        }

        err.classList.add('d-none');
        let url = '/api/reports/finished-auctions?';
        if (from) url += `from=${from}&`;
        if (to) url += `to=${to}`;
        window.open(url, '_blank');
    }
</script>