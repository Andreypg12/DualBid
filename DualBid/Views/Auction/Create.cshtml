@model DualBid.Application.DTOs.AuctionDTO

@{
    ViewData["Title"] = "Create Auction";
}

<h1>Create New Auction</h1>

<h4>Auction Details</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Comic selection (corregido el label) -->
            <div class="mb-3">
                <label asp-for="ComicId" class="form-label fw-semibold">Comic</label>
                <select asp-for="ComicId" class="form-select" required>
                    <option value="">-- Select a comic --</option>
                    @if (ViewBag.ListComics != null)
                    {
                        foreach (var comic in ViewBag.ListComics)
                        {
                            <option value="@comic.Id">@comic.Title</option>
                        }
                    }
                </select>
                <span asp-validation-for="ComicId" class="text-danger"></span>
            </div>

            <!-- Start Date -->
            <div class="mb-3">
                <label asp-for="StartDate" class="form-label fw-semibold"></label>
                <input asp-for="StartDate" class="form-control" type="datetime-local"
                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
                <small class="text-muted">Format: YYYY-MM-DD HH:MM</small>
            </div>

            <!-- Expected End Date -->
            <div class="mb-3">
                <label asp-for="ExpectedEndDate" class="form-label fw-semibold"></label>
                <input asp-for="ExpectedEndDate" class="form-control" type="datetime-local"
                       value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="ExpectedEndDate" class="text-danger"></span>
                <small class="text-muted">Must be after start date</small>
            </div>

            <!-- Base Price -->
            <div class="mb-3">
                <label asp-for="BasePrice" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="BasePrice" class="form-control" type="number" step="0.01" min="0.01" />
                </div>
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>

            <!-- Minimum Increase -->
            <div class="mb-3">
                <label asp-for="MinimunIncrease" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="MinimunIncrease" class="form-control" type="number" step="0.01" min="0.01" />
                </div>
                <span asp-validation-for="MinimunIncrease" class="text-danger"></span>
                <small class="text-muted">Should be less than base price</small>
            </div>

            <!-- Hidden field for StateId (Active by default) -->
            <input type="hidden" asp-for="StateId" value="1" />

            <!-- Form buttons -->
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Create
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>

<!-- SweetAlert desde el Controller -->
@if (ViewBag.Notificacion != null)
{
    <script>
        Swal.fire(@Html.Raw(ViewBag.Notificacion));
    </script>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Validación adicional en cliente
        document.addEventListener('DOMContentLoaded', function() {
            const startDate = document.getElementById('StartDate');
            const endDate = document.getElementById('ExpectedEndDate');
            const basePrice = document.getElementById('BasePrice');
            const minIncrease = document.getElementById('MinimunIncrease');

            // Configurar fechas mínimas
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            const nowStr = now.toISOString().slice(0, 16);

            startDate.min = nowStr;
            endDate.min = nowStr;

            // Validar que end date sea mayor que start date
            startDate.addEventListener('change', function() {
                endDate.min = this.value;
                if (endDate.value && endDate.value < this.value) {
                    endDate.value = this.value;
                }
            });

            // Validar que minimum increase sea menor que base price
            basePrice.addEventListener('input', function() {
                const base = parseFloat(this.value) || 0;
                const min = parseFloat(minIncrease.value) || 0;

                if (min >= base) {
                    minIncrease.setCustomValidity('Minimum increase must be less than base price');
                } else {
                    minIncrease.setCustomValidity('');
                }
            });

            minIncrease.addEventListener('input', function() {
                const base = parseFloat(basePrice.value) || 0;
                const min = parseFloat(this.value) || 0;

                if (min >= base) {
                    this.setCustomValidity('Minimum increase must be less than base price');
                } else {
                    this.setCustomValidity('');
                }
            });
        });
    </script>
}