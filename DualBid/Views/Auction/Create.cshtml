@model DualBid.ViewModels.Auction.CreateAuctionViewModel

@{
    ViewData["Title"] = "Create Auction";
}

<div class="container-fluid px-4 py-5">
    <!-- Header -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold text-primary mb-2">
                        <i class="bi bi-hammer me-2"></i>Create New Auction
                    </h1>
                    <p class="text-secondary">Select a comic and set the auction details</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna izquierda: Formulario de subasta -->
        <div class="col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-gradient-primary text-white border-0 rounded-top-4 py-3">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-cash-stack me-2"></i>Auction Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="auctionForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Selected Comic Display -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-star-fill text-warning me-1"></i>Selected Comic
                            </label>
                            <div id="selectedComicDisplay" class="selected-comic-card bg-light rounded-3 p-3 border">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-white rounded-2 p-2 shadow-sm">
                                        <i class="bi bi-book fs-3 text-primary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <span class="text-muted small d-block">No comic selected</span>
                                        <strong id="selectedComicTitle" class="text-primary fs-5">-</strong>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" asp-for="Auction.ComicId" id="ComicId" />
                            <span asp-validation-for="Auction.ComicId" class="text-danger"></span>
                        </div>

                        <!-- Start Date -->
                        <div class="mb-3">
                            <label asp-for="Auction.StartDate" class="form-label fw-semibold">
                                <i class="bi bi-calendar-event me-1"></i> Start Date
                            </label>
                            <input asp-for="Auction.StartDate" class="form-control" type="datetime-local"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                   id="StartDate" />
                            <span asp-validation-for="Auction.StartDate" class="text-danger"></span>
                            <small class="text-muted">The auction will start at this date and time</small>
                        </div>

                        <!-- Expected End Date -->
                        <div class="mb-3">
                            <label asp-for="Auction.ExpectedEndDate" class="form-label fw-semibold">
                                <i class="bi bi-calendar-check me-1"></i> Expected End Date
                            </label>
                            <input asp-for="Auction.ExpectedEndDate" class="form-control" type="datetime-local"
                                   value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")"
                                   id="ExpectedEndDate" />
                            <span asp-validation-for="Auction.ExpectedEndDate" class="text-danger"></span>
                            <small class="text-muted">Must be after start date</small>
                        </div>

                        <!-- Base Price -->
                        <div class="mb-3">
                            <label asp-for="Auction.BasePrice" class="form-label fw-semibold">
                                <i class="bi bi-coin me-1"></i> Base Price
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="Auction.BasePrice" class="form-control" type="number" step="0.01" min="0.01" id="BasePrice" />
                            </div>
                            <span asp-validation-for="Auction.BasePrice" class="text-danger"></span>
                            <small class="text-muted">Starting bid amount</small>
                        </div>

                        <!-- Minimum Increase -->
                        <div class="mb-4">
                            <label asp-for="Auction.MinimunIncrease" class="form-label fw-semibold">
                                <i class="bi bi-arrow-up-circle me-1"></i> Minimum Increase
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="Auction.MinimunIncrease" class="form-control" type="number" step="0.01" min="0.01" id="MinimunIncrease" />
                            </div>
                            <span asp-validation-for="Auction.MinimunIncrease" class="text-danger"></span>
                            <small class="text-muted">Minimum amount each bid must increase by</small>
                        </div>

                        <!-- Hidden fields -->
                        <input type="hidden" asp-for="Auction.StateId" value="1" />

                        <!-- Form buttons -->
                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1 rounded-3" id="submitBtn">
                                <i class="bi bi-check2-circle me-2"></i> Create Auction
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                                <i class="bi bi-arrow-left me-2"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="card border-0 bg-gradient-info rounded-4 mt-4">
                <div class="card-body p-3">
                    <div class="d-flex gap-2 align-items-start">
                        <i class="bi bi-lightbulb-fill text-warning fs-5 mt-1"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Pro Tips</h6>
                            <p class="small text-dark mb-0">
                                • Choose an attractive starting price to encourage bids<br>
                                • Set a reasonable minimum increase (5-10% of base price)<br>
                                • Give enough time for bidding (3-7 days recommended)<br>
                                • Make sure your comic images are clear and appealing
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna derecha: Selección de cómics -->
        <div class="col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-semibold mb-0">
                            <i class="bi bi-book me-2 text-primary"></i>Select a Comic
                        </h5>
                        <span class="badge bg-light text-dark rounded-pill">
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i>
                            @Model.Comics.Count() comics available
                        </span>
                    </div>
                    <p class="text-muted small mt-1 mb-0">Click on any comic card to select it for auction</p>
                </div>
                <div class="card-body p-4">
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4" id="comicsGrid">
                        @foreach (var comic in Model.Comics)
                        {
                            <div class="col">
                                <div class="comic-card card h-100 border-0 shadow-sm rounded-4 overflow-hidden cursor-pointer transition-all"
                                     data-comic-id="@comic.Id"
                                     onclick="selectComic(this, @comic.Id, '@comic.Title.Replace("'", "\\'")')">
                                    <!-- Imagen -->
                                    <div class="comic-image-container position-relative" style="height: 260px; background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);">
                                        @{
                                            var hasImage = comic.ImgComic != null && comic.ImgComic.Any() && comic.ImgComic.FirstOrDefault()?.Img != null;
                                        }
                                        @if (hasImage)
                                        {
                                            var img = comic.ImgComic.FirstOrDefault();
                                            var base64 = Convert.ToBase64String(img.Img);
                                            <img class="comic-image w-100 h-100 object-fit-cover"
                                                 src="data:image/jpeg;base64,@base64"
                                                 alt="@comic.Title"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex flex-column justify-content-center align-items-center text-muted">
                                                <i class="bi bi-image fs-1 mb-2"></i>
                                                <span class="small">No image available</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Contenido -->
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold mb-2 text-truncate" title="@comic.Title">@comic.Title</h6>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                <i class="bi bi-building me-1"></i>@(comic.Publisher.Description ?? "Unknown")
                                            </small>
                                            <small class="text-muted">
                                                <i class="bi bi-calendar me-1"></i>@(comic.YearPublication?.ToString() ?? "N/A")
                                            </small>
                                        </div>
                                    </div>

                                    <!-- Selection indicator (solo un pequeño borde verde) -->
                                    <div class="selection-indicator position-absolute top-0 end-0 m-2" style="display: none;">
                                        <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
    }

    .comic-card {
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

        .comic-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.15) !important;
        }

        .comic-card.selected {
            border: 3px solid #28a745;
            box-shadow: 0 8px 20px rgba(40, 167, 69, 0.25) !important;
        }

            .comic-card.selected .selection-indicator {
                display: block !important;
            }

    .comic-image {
        transition: transform 0.3s ease;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .comic-card:hover .comic-image {
        transform: scale(1.05);
    }

    .comic-image-container {
        overflow: hidden;
    }

    .selected-comic-card {
        transition: all 0.3s ease;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

        .selected-comic-card.has-selection {
            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            border-color: #28a745;
        }

    .object-fit-cover {
        object-fit: cover;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .transition-all {
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.02);
        }

        100% {
            transform: scale(1);
        }
    }

    .comic-card.selected {
        animation: pulse 0.3s ease;
    }

    .container-fluid {
        max-width: 1900px;
        margin: 0 auto;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let selectedComicId = null;

        function selectComic(element, comicId, comicTitle) {
            // Remove selection from all cards
            document.querySelectorAll('.comic-card').forEach(card => {
                card.classList.remove('selected');
                const indicator = card.querySelector('.selection-indicator');
                if (indicator) indicator.style.display = 'none';
            });

            // Add selection to clicked card
            element.classList.add('selected');
            const selectedIndicator = element.querySelector('.selection-indicator');
            if (selectedIndicator) selectedIndicator.style.display = 'block';

            // Update hidden field
            selectedComicId = comicId;
            const comicIdField = document.getElementById('ComicId');
            if (comicIdField) {
                comicIdField.value = comicId;
            }

            // Update visual display
            const selectedDisplay = document.getElementById('selectedComicTitle');
            const selectedContainer = document.getElementById('selectedComicDisplay');
            if (selectedDisplay) {
                selectedDisplay.textContent = comicTitle;
                selectedContainer.classList.add('has-selection');
            }

            // Enable submit button
            const submitBtn = document.getElementById('submitBtn');
            if (submitBtn) {
                submitBtn.disabled = false;
            }
        }

        // Form validations
        document.addEventListener('DOMContentLoaded', function() {
            const startDate = document.getElementById('StartDate');
            const endDate = document.getElementById('ExpectedEndDate');
            const basePrice = document.getElementById('BasePrice');
            const minIncrease = document.getElementById('MinimunIncrease');

            // Set minimum dates
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            const nowStr = now.toISOString().slice(0, 16);

            if (startDate) startDate.min = nowStr;
            if (endDate) endDate.min = nowStr;

            // Validate dates
            if (startDate && endDate) {
                startDate.addEventListener('change', function() {
                    endDate.min = this.value;
                    if (endDate.value && endDate.value < this.value) {
                        endDate.value = this.value;
                    }
                });
            }

            // Validate minimum increase vs base price
            function validateMinIncrease() {
                const base = parseFloat(basePrice?.value) || 0;
                const min = parseFloat(minIncrease?.value) || 0;

                if (min >= base && base > 0) {
                    minIncrease.setCustomValidity('Minimum increase must be less than base price');
                    return false;
                } else {
                    minIncrease.setCustomValidity('');
                    return true;
                }
            }

            if (basePrice && minIncrease) {
                basePrice.addEventListener('input', validateMinIncrease);
                minIncrease.addEventListener('input', validateMinIncrease);
            }

            // Validate comic selection
            function validateComicSelection() {
                if (!selectedComicId || selectedComicId === 0) {
                    return false;
                }
                return true;
            }

            // Form submission validation
            const form = document.getElementById('auctionForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    return true;
                });
            }
        });
    </script>
}