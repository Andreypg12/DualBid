@model DualBid.Application.DTOs.AuctionDTO

@using System.Security.Claims

<!-- MODAL DE EDICIÓN -->
<div class="modal fade" id="editAuctionModal" tabindex="-1" aria-labelledby="editAuctionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white">
                <h5 class="modal-title fw-bold" id="editAuctionModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>
                    Edit Auction
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Edit" asp-controller="Auction" method="post" id="editAuctionForm">
                <div class="modal-body">
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="StartDate" class="form-label fw-semibold">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>
                                    Start Date
                                </label>
                                <input asp-for="StartDate" class="form-control" type="datetime-local" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ExpectedEndDate" class="form-label fw-semibold">
                                    <i class="bi bi-calendar-check me-1 text-primary"></i>
                                    Expected End Date
                                </label>
                                <input asp-for="ExpectedEndDate" class="form-control" type="datetime-local" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="ExpectedEndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="BasePrice" class="form-label fw-semibold">
                                    <i class="bi bi-cash me-1 text-primary"></i>
                                    Base Price
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="BasePrice" class="form-control" type="number" step="1" min="1" />
                                </div>
                                <span asp-validation-for="BasePrice" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="MinimunIncrease" class="form-label fw-semibold">
                                    <i class="bi bi-arrow-up-circle me-1 text-primary"></i>
                                    Minimum Increase
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="MinimunIncrease" class="form-control" type="number" step="1" min="1" />
                                </div>
                                <span asp-validation-for="MinimunIncrease" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Información del Comic (solo lectura) -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-book text-primary me-2"></i>
                            <span class="fw-semibold">Comic Information (Read Only)</span>
                        </div>
                        <div class="bg-light p-3 rounded">
                            <div class="row">
                                <div class="col-md-8">
                                    <p class="mb-1"><strong>Title:</strong> @Model.Comic.Title</p>
                                    <p class="mb-0"><strong>ISBN:</strong> @Model.Comic.Isbn</p>
                                </div>
                                <div class="col-md-4">
                                    <p class="mb-1"><strong>Edition:</strong> #@Model.Comic.EditionNumber</p>
                                    <p class="mb-0"><strong>Year:</strong> @Model.Comic.YearPublication</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["Notificacion"] != null || ViewBag.Notificacion != null)
{
    var notificacion = TempData["Notificacion"] ?? ViewBag.Notificacion;
    <script type="text/javascript">

        const payload = @Html.Raw(notificacion);

        if (payload) {
            Swal.fire(payload);
        }
    </script>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}