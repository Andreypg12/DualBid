@model DualBid.ViewModels.Auction.AuctionIndexViewModel
@{
    ViewData["Title"] = "Auctions";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Auctions</h1>
    <div class="d-flex gap-4">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label class="small text-muted mb-0" for="state">Show:</label>
            <select id="state" name="state" class="form-select form-select-sm" onchange="this.form.submit()">
                @if (Model.SelectedState == "active")
                {
                    <option value="active" selected>Active</option>
                    <option value="inactive">Inactive</option>
                }
                else
                {
                    <option value="active">Active</option>
                    <option value="inactive" selected>Inactive</option>
                }
            </select>
        </form>

        <a asp-controller="Auction" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus"></i> Create Auction
        </a>
    </div>
</div>

@if (!Model.Auctions.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>
        <div>No @(Model.SelectedState == "inactive" ? "inactive" : "active") auctions available.</div>
    </div>
}
else
{
    <section aria-label="Auction list">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model.Auctions)
            {
                <div class="col">
                    <a asp-controller="Auction" asp-action="Details" asp-route-id="@item.Id"
                       class="text-decoration-none text-dark">
                        <article class="card h-100 shadow-sm border-0 auction-card">
                            <div class="position-relative rounded-top overflow-hidden bg-body-tertiary"
                                 style="height: 360px;">
                                @if (item.Comic?.ImgComic != null && item.Comic.ImgComic.Any())
                                {
                                    var img = item.Comic.ImgComic.First();
                                    <img class="w-100 h-100 object-fit-cover"
                                         src="data:image/jpeg;base64,@Convert.ToBase64String(img.Img)"
                                         alt="Cover of @item.Comic.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                        <i class="bi bi-image fs-1"></i>
                                        <span class="small">No Cover</span>
                                    </div>
                                }
                                <div class="auction-overlay d-flex align-items-center justify-content-center">
                                    <span class="badge bg-dark fs-6">
                                        <i class="bi bi-eye-fill me-1"></i> View Auction
                                    </span>
                                </div>
                            </div>

                            <div class="card-body bg-light text-center">
                                <h2 class="h6 fw-semibold mb-3 text-truncate"
                                    title="@item.Comic?.Title">
                                    <i class="bi bi-book me-1"></i>
                                    @item.Comic?.Title
                                </h2>

                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    <span class="badge text-bg-light border">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        @(Model.SelectedState == "inactive" ? "Ended" : "End Date")<br />
                                        @item.ExpectedEndDate.ToString("dd MMM yyyy : HH:mm")
                                    </span>

                                    <span class="badge text-bg-light border">
                                        <i class="bi bi-cash-coin me-1"></i>
                                        @(Model.SelectedState == "inactive" ? "Last bid" : "Current Bid")<br />
                                        $@item.CurrentBid.AmountOffered
                                    </span>

                                    <span class="badge text-bg-light border">
                                        <i class="bi bi-hammer me-1"></i>
                                        Bids<br />
                                        @item.NumberOfBids
                                    </span>
                                </div>
                                @* Informacion extra cuando esta inactivo *@
                                @if (Model.SelectedState == "inactive")
                                {
                                    <hr class="my-3" />
                                    <div class="small text-start">
                                        <div><strong>Auction status: </strong> @item.State.Description</div>
                                    </div>
                                }
                            </div>
                        </article>
                    </a>
                </div>
            }
        </div>
    </section>
}