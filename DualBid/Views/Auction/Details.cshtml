@model DualBid.Application.DTOs.AuctionDTO
@using System.Globalization
@using System.Security.Claims

@{
    ViewData["Title"] = "Auction Details";

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@* Header *@
<div class="bg-gradient-primary text-white py-4 mb-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="h2 mb-0 fw-light">
                <i class="bi bi-hammer me-2"></i>
                Auction Details
            </h1>
            @{
                var stateId = Model.State.Id;
                var (stateClass, stateIcon) = stateId switch
                {
                    1 => ("bg-warning", "bi-pause-circle-fill"),
                    2 => ("bg-success", "bi-play-circle-fill"),
                    3 => ("bg-primary", "bi-stop-circle-fill"),
                    4 => ("bg-danger", "bi-stop-circle-fill"),
                    _ => ("bg-secondary", "bi-question-circle-fill")
                };
            }

            @* Determinar Ganador de la puja *@
            @* Editado por ALE *@
            <span id="auctionStateBadge" class="badge @stateClass bg-opacity-75 fs-6 px-4 py-3 rounded-pill shadow-sm">
                <i id="auctionStateIcon" class="bi @stateIcon me-2"></i>
                <span id="auctionStateText">@Model.State.Description</span>
            </span>
        </div>
    </div>
</div>

<section class="container py-4">

    <div class="row g-4">

        <div class="col-lg-4">

            @* imagen del comic *@
            <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                <div class="position-relative">
                    @{
                        var validImages = Model.Comic.ImgComic?.Where(i => i.Img != null && i.Img.Length > 0).ToList();
                        var hasImages = validImages.Any();
                    }

                    @if (hasImages)
                    {
                        <div id="carouselComic-@Model.Id" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @{
                                    var index = 0;
                                    foreach (var img in validImages)
                                    {
                                        var base64 = Convert.ToBase64String(img.Img);
                                        var src = $"data:image/jpeg;base64,{base64}";
                                        <div class="carousel-item @(index == 0 ? "active" : "")">
                                            <img src="@src" class="d-block w-100 comic-carousel-img" alt="Comic image">
                                        </div>
                                        index++;
                                    }
                                }
                            </div>

                            @if (validImages.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#carouselComic-@Model.Id" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carouselComic-@Model.Id" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            }
                        </div>

                        @* Carousel flechas *@
                        @if (validImages.Count > 1)
                        {
                            <div class="carousel-indicators position-absolute bottom-0 mb-2">
                                @for (int i = 0; i < validImages.Count; i++)
                                {
                                    <button type="button" data-bs-target="#carouselComic-@Model.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="comic-placeholder-img">
                            <div class="text-center text-muted">
                                <i class="bi bi-image fs-1 d-block mb-3"></i>
                                <span>No cover image available</span>
                            </div>
                        </div>
                    }
                </div>

                @* detalle de comics *@
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i>
                        Comic Details
                    </h5>

                    <div class="vstack gap-3">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                            <span class="text-muted">
                                <i class="bi bi-upc-scan me-2"></i>ISBN
                            </span>
                            <span class="fw-semibold font-monospace">@Model.Comic.Isbn</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                            <span class="text-muted">
                                <i class="bi bi-bookmark me-2"></i>Edition
                            </span>
                            <span class="fw-semibold">#@Model.Comic.EditionNumber</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                            <span class="text-muted">
                                <i class="bi bi-calendar me-2"></i>Publication Year
                            </span>
                            <span class="fw-semibold">@Model.Comic.YearPublication</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                            <div class="rounded-3">
                                <span class="text-muted">
                                    <i class="bi bi-shield-check me-2"></i>Condition
                                </span>
                                <span class="badge bg-@(Model.Comic.StateConservation?.Id == 1 ? "success" : "warning") rounded-pill px-4 py-2 fs-6">
                                    <i class="bi bi-stars me-2"></i>@(Model.Comic.StateConservation?.Description ?? "N/A")
                                </span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                            @if (@Model.Comic.Category != null && @Model.Comic.Category.Any())
                            {
                                <div class="mb-3">
                                    <div class="d-flex align-items-center gap-2 mb-2 text-dark">
                                        <i class="bi bi-tags fs-6"></i>
                                        <span class="small fw-semibold">Categories</span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var category in @Model.Comic.Category)
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-normal">
                                                <i class="bi bi-asterisk text-warning me-1"></i>
                                                @category.Description
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h3 fw-bold text-primary mb-3">@Model.Comic.Title</h2>
                    <p class="text-muted mb-0 comic-description">
                        @Model.Comic.Description
                    </p>
                </div>
            </div>
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h4 fw-bold text-primary mb-3">Seller: </h2>
                    <p class="text-muted mb-0 comic-description">
                        @Model.CreatorUser.CompleteName - @Model.CreatorUser.Email
                    </p>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 bg-gradient-success text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="small opacity-75">Current Bid</span>
                                <i class="bi bi-cash-stack fs-4 opacity-75"></i>
                            </div>
                            <div class="h2 fw-bold mb-0" id="currentBidLabel">
                                $@((Model.CurrentBid != null && Model.CurrentBid.AmountOffered > 0 ?
                                                                Model.CurrentBid.AmountOffered :
                                                                Model.BasePrice).ToString("N0"))
                            </div>
                            <small class="opacity-75">USD</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 bg-gradient-info text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="small opacity-75">Minimum Increase</span>
                                <i class="bi bi-arrow-up-circle fs-4 opacity-75"></i>
                            </div>
                            <div class="h2 fw-bold mb-0">$@Model.MinimunIncrease.ToString("N0")</div>
                            <small class="opacity-75">USD per bid</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Base Price</span>
                                <i class="bi bi-coin text-warning"></i>
                            </div>
                            <div class="fw-bold">$@Model.BasePrice.ToString("N0")</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <span class="text-muted small d-block">Total bids</span>
                                    <div class="fw-bold display-6 mb-0" id="totalBidsLabel">@Model.NumberOfBids</div>
                                </div>
                                <div id="bidHistoryContainer">
                                    @if (Model.NumberOfBids == 0)
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center ps-3 ms-3 border-start text-muted"
                                             style="cursor: not-allowed; opacity: 0.6;"
                                             title="No bids available yet">
                                            <i class="bi bi-clock-history fs-4 mb-1"></i>
                                            <span class="small fw-semibold">History</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-controller="Bid"
                                           asp-action="AuctionBiddingHistory"
                                           asp-route-auctionId="@Model.Id"
                                           asp-route-comicTitle="@Model.Comic?.Title"
                                           class="d-flex flex-column align-items-center justify-content-center text-decoration-none text-primary ps-3 ms-3 border-start"
                                           title="Go to bid history">
                                            <i class="bi bi-clock-history fs-4 mb-1"></i>
                                            <span class="small fw-semibold">History</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Time Remaining</span>
                                <i class="bi bi-hourglass-split text-danger"></i>
                            </div>
                            <div class="fw-bold" id="timeRemainingLabel">
                                @if (Model.ActualEndDate == null)
                                {
                                    var timeLeft = Model.ExpectedEndDate - DateTime.Now;
                                    if (timeLeft.TotalDays > 0)
                                    {
                                        <span>@timeLeft.Days d @timeLeft.Hours h @timeLeft.Minutes m</span>
                                    }
                                    else if (timeLeft.TotalHours > 0)
                                    {
                                        <span>@timeLeft.Hours h @timeLeft.Minutes m</span>
                                    }
                                    else if (timeLeft.TotalMinutes > 0)
                                    {
                                        <span>@timeLeft.Minutes m</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">Ending soon</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-danger">Ended</span>
                                }
                            </div>
                            @* Después del contador de tiempo, agrega esto *@
                            <div class="alert alert-info mt-3" id="timeStatusAlert" style="display: none;">
                                <i class="bi bi-info-circle-fill me-2"></i>
                                <span id="timeStatusMessage"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">
                        <i class="bi bi-calendar-check text-primary me-2"></i>
                        Auction Timeline
                    </h5>

                    <div class="timeline">
                        <div class="d-flex align-items-center mb-4">
                            <div class="timeline-icon-base timeline-icon-success me-3">
                                <i class="bi bi-play-fill"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold">Started</span>
                                    <small class="text-muted">@Model.StartDate.ToString("dd MMM yyyy 'at' HH:mm")</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <div id="iconEnded" class="timeline-icon-base @(Model.ActualEndDate == null ? "timeline-icon-warning" : "timeline-icon-danger") me-3">
                                <i id="iIconEnded" class="bi @(Model.ActualEndDate == null ? "bi-pause" : "bi-stop-fill")"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <span id="timeLineEndedDate" class="fw-semibold">@(Model.ActualEndDate == null ? "Expected End" : "Ended")</span>
                                    <small class="text-muted">
                                        @if (Model.ActualEndDate == null)
                                        {
                                            @Model.ExpectedEndDate.ToString("dd MMM yyyy 'at' HH:mm")
                                        }
                                        else
                                        {
                                            @Model.ActualEndDate.Value.ToString("dd MMM yyyy 'at' HH:mm")
                                        }
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Auctions
        </a>

        <div id="divActionsButtons" class="d-flex gap-3">
            @{
                var currentUserId = int.Parse(userId ?? "0");
                bool isAuctionActive = Model.ActualEndDate == null && Model.State.Id == 2;
                bool isAuctionClosed = Model.State.Id == 3 || Model.State.Id == 4;
                bool isCurrentUserCreator = currentUserId == Model.CreatorUser.Id;
                bool canPlaceBid = isAuctionActive && !isCurrentUserCreator && Model.State.Id == 2;

                bool canEditAuction = isCurrentUserCreator &&
                (Model.State.Id == 1  && !Model.Bids.Any());

                bool canActivateAuction = isCurrentUserCreator &&
                Model.StartDate <= DateTime.Now &&
                Model.State.Id == 1;


                bool canCloseAuction = isCurrentUserCreator &&
                (Model.State.Id == 1 || Model.State.Id == 2) &&
                !Model.Bids.Any();
            }

            @* Botón para pujar *@
            @if (canPlaceBid && (User.IsInRole("Buyer") || User.IsInRole("Administrator")))
            {
                <a asp-controller="Bid"
                   asp-action="Create"
                   asp-route-auctionId="@Model.Id"
                   asp-route-titleComicAuction="@Model.Comic?.Title"
                   class="btn btn-primary btn-lg px-5 shadow-sm">
                    <i class="bi bi-cash-stack me-2"></i>
                    Place Your Bid
                </a>
            }
            
            else if (!canPlaceBid && !isCurrentUserCreator && !isAuctionClosed)
            {
                <div class="alert alert-info d-flex align-items-center gap-3 mb-0 py-3 px-4 rounded-3 shadow-sm" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdef5 100%); border: none;">
                    <i class="bi bi-clock-history fs-2 text-primary"></i>
                    <div>
                        <h6 class="fw-bold mb-1 text-primary">
                            <i class="bi bi-hourglass-split me-1"></i>
                            Auction Not Started Yet
                        </h6>
                        <p class="mb-0 text-dark">
                            This auction will begin on <strong>@Model.StartDate.ToString("dd/MM/yyyy HH:mm")</strong>.
                            Come back then to place your bid.
                        </p>
                    </div>
                </div>
            }
            else if (isAuctionClosed)
            {
                <button class="btn btn-secondary btn-lg px-5" disabled>
                    <i class="bi bi-lock-fill me-2"></i>
                    Auction Ended
                </button>
            }


            @* Botones para el creador *@
            @if (isCurrentUserCreator)
            {

                @if (canCloseAuction)
                {
                    <form asp-action="CloseAuction" asp-controller="Auction" method="post" style="display: inline;" id="closeAuctionForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="button" id="closeAuctionBtn"
                                class="btn btn-custom-close btn-lg px-5 shadow-sm"
                                onclick="confirmAction('closeAuctionForm', 'Close Auction', 'Are you sure you want to close this auction?', 'warning')">
                            <i class="bi bi-stop-fill me-2"></i>
                            Close Auction
                        </button>
                    </form>
                }

                @if (canActivateAuction)
                {
                    <form asp-action="ActivateAuction" asp-controller="Auction" method="post" style="display: inline;" id="activateAuctionForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="button"
                                class="btn btn-custom-activate btn-lg px-5 shadow-sm"
                                onclick="confirmAction('activateAuctionForm', 'Activate Auction', 'Are you sure you want to activate this auction?', 'success')">
                            <i class="bi bi-play-fill me-2"></i>
                            Activate Auction
                        </button>
                    </form>
                }

                @* Botón de edición general *@
                @if (canEditAuction)
                {
                    <button type="button"
                            class="btn btn-outline-primary btn-lg px-4 shadow-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#editAuctionModal">
                        <i class="bi bi-pencil-square me-2"></i>
                        Edit Auction
                    </button>
                }
            }
        </div>
    </div>


    @* Editado por ALE *@
    @* Esto es para el ganador de la subasta *@
    <div id="auctionResultContainer">
        @if (Model.State.Id == 3)
        {
            <div class="card border-0 shadow-sm mt-4" style="border-radius:16px;overflow:hidden;background:#fff;">
                <div style="height:4px;background:linear-gradient(90deg,#1a7a4a,#2ecc7a);"></div>
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-1" style="font-size:18px;">Auction result</h5>
                            <p class="mb-0" style="font-size:13px;color:#999;">This auction has ended</p>
                        </div>
                        <span class="px-3 py-1 rounded-pill fw-semibold"
                              style="font-size:12px;background:#e8f5ee;color:#1a7a4a;">Finished</span>
                    </div>
                    <hr style="border-color:#f0f0f0;">
                    @if (Model.WinningBid != null)
                    {
                        <div class="d-flex justify-content-between align-items-center py-3"
                             style="border-bottom:0.5px solid #f2f2f2;">
                            <span style="font-size:13px;color:#888;">Winner</span>
                            <span class="fw-bold" style="font-size:15px;">@Model.WinningBid.User.CompleteName</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-3">
                            <span style="font-size:13px;color:#888;">Final price</span>
                            <span class="fw-bold" style="font-size:22px;color:#1a7a4a;">
                                $@Model.WinningBid.AmountOffered.ToString("N2")
                            </span>
                        </div>
                        @if (Model.WinningBid.UserId == currentUserId)
                        {
                            <div class="d-flex align-items-center gap-3 mt-3 p-3"
                                 style="background:#f0f9f4;border-radius:10px;">
                                <div style="width:32px;height:32px;border-radius:50%;background:#1a7a4a;
                                                    display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi bi-check-lg text-white" style="font-size:14px;"></i>
                                </div>
                                <div>
                                    <p class="fw-bold mb-0" style="font-size:14px;color:#1a7a4a;">You have won this auction</p>
                                    <span style="font-size:12px;color:#5aaa7a;">Congratulations on your winning bid</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="mb-0" style="font-size:14px;color:#aaa;">No bids were placed in this auction.</p>
                    }
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_PaymentModal")

    @await Html.PartialAsync("_EditAuctionModal", Model)
</section>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
    }

    .timeline {
        position: relative;
        padding-left: 23px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 20px;
            bottom: 20px;
            width: 2px;
            background: #e9ecef;
        }

    .text-white-50 {
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    /* Clases para imágenes */
    .comic-carousel-img {
        height: 500px;
        object-fit: cover;
    }

    .comic-placeholder-img {
        height: 500px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f8f9fa;
    }

    /* Clases para timeline icons */
    .timeline-icon-base {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: white;
    }

    .timeline-icon-success {
        background-color: #198754;
    }

    .timeline-icon-warning {
        background-color: #ffc107;
    }

    .timeline-icon-danger {
        background-color: #dc3545;
    }

    /* Clase para descripción */
    .comic-description {
        line-height: 1.6;
    }

    .btn-custom-close {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .btn-custom-close:hover {
            background-color: #bb2d3b;
            border-color: #bb2d3b;
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .btn-custom-close:active {
            transform: translateY(0);
        }

    .btn-custom-activate {
        background-color: #20c997;
        color: white;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .btn-custom-activate:hover {
            background-color: #1ba87e;
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .btn-custom-activate:active {
            transform: translateY(0);
        }
</style>


@* 
   Reemplaza SOLO la sección @section Scripts { ... } al final de tu Details.cshtml
   El resto del HTML no cambia en absoluto.
*@

@section Scripts {
    <script>
                window.auctionDetailsConfig = {
            auctionId: "@Model.Id",
            userId: "@(userId ?? "0")",
            isCreator: "@isCurrentUserCreator.ToString().ToLower()",
            comicTitle: "@Html.Raw(Model.Comic?.Title?.Replace("\"", "\\\""))",
            endDate: "@Model.ExpectedEndDate.ToUniversalTime().ToString("o")"
        };
    </script>

    <script>
        function confirmAction(formId, title, message, iconType) {
            const iconMap = {
                'success': 'question',
                'warning': 'warning',
                'info': 'info'
            };

            Swal.fire({
                title: title,
                text: message,
                icon: iconMap[iconType] || 'question',
                showCancelButton: true,
                confirmButtonColor: iconType === 'success' ? '#28a745' : '#ffc107',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, proceed',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }
    </script>

    <!-- SignalR y scripts de la página de detalles -->
    <script src="~/js/auctionDetails.js"></script>
    <script src="~/js/payment.js"></script>
}

