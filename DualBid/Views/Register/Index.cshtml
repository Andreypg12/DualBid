<!-- Views/Register/Index.cshtml -->
@model DualBid.ViewModels.Register.ViewModelRegister
@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DualBid.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header text-center py-4 border-0 mt-5">
                        <div class="mb-3">
                            <i class="bi bi-person-plus-fill display-4"></i>
                        </div>
                        <h2 class="h3 mb-2">Create Account</h2>
                        <p class="text-light-emphasis mb-0">
                            Join DualBid to start bidding and selling
                        </p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <form id="registerForm" asp-controller="Register" asp-action="Register" method="post" asp-antiforgery="true">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-semibold">Name</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <input asp-for="Name"
                                           class="form-control"
                                           type="text"
                                           placeholder="Enter your name" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LastNames" class="form-label fw-semibold">Last Names</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person-lines-fill"></i>
                                    </span>
                                    <input asp-for="LastNames"
                                           class="form-control"
                                           type="text"
                                           placeholder="Enter your last names" />
                                </div>
                                <span asp-validation-for="LastNames" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope-fill"></i>
                                    </span>
                                    <input asp-for="Email"
                                           class="form-control"
                                           type="email"
                                           placeholder="Enter your email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input asp-for="Password"
                                           id="Password"
                                           class="form-control"
                                           type="password"
                                           placeholder="Create a password" />
                                    <button class="btn btn-outline-light border"
                                            type="button"
                                            id="togglePassword"
                                            title="Show or hide password">
                                        <i class="bi bi-eye text-black"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="form-text">
                                    <small>Password must be at least 6 characters</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-shield-lock-fill"></i>
                                    </span>
                                    <input asp-for="ConfirmPassword"
                                           id="ConfirmPassword"
                                           class="form-control"
                                           type="password"
                                           placeholder="Confirm your password" />
                                    <button class="btn btn-outline-light border"
                                            type="button"
                                            id="toggleConfirmPassword"
                                            title="Show or hide password">
                                        <i class="bi bi-eye text-black"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>


                            <div class="mb-4">
                                <label class="form-label fw-semibold mb-3">Account Type</label>

                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <div class="role-card buyer" data-role="3">
                                            <div class="check-mark">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </div>
                                            <div class="role-icon">
                                                <i class="bi bi-cart-fill"></i>
                                            </div>
                                            <div class="role-title">Buyer</div>
                                            <div class="role-description">
                                                <i class="bi bi-trophy"></i> Bid and win auctions
                                            </div>
                                            <div class="mt-2">
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-star-fill"></i> Start Bidding
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="role-card seller" data-role="2">
                                            <div class="check-mark">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </div>
                                            <div class="role-icon">
                                                <i class="bi bi-shop"></i>
                                            </div>
                                            <div class="role-title">Seller</div>
                                            <div class="role-description">
                                                <i class="bi bi-graph-up"></i> Create auctions and sell products
                                            </div>
                                            <div class="mt-2">
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-rocket-takeoff"></i> Start Selling
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <input type="hidden" asp-for="RoleId" id="selectedRole" value="" />
                                <span asp-validation-for="RoleId" class="text-danger small d-block mt-2"></span>
                            </div>

                            <div class="d-grid mt-4">
                                <button id="btnRegister" class="btn btn-primary btn-lg" type="submit">
                                    <span id="btnText">
                                        <i class="bi bi-person-plus-fill me-2"></i>Create Account
                                    </span>
                                    <span id="btnSpinner" class="d-none">
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        Creating account...
                                    </span>
                                </button>
                            </div>

                            <div class="text-center mt-3">
                                <small class="text-muted">
                                    Already have an account?
                                    <a asp-controller="Login" asp-action="Index" class="text-decoration-none">
                                        Login here
                                    </a>
                                </small>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer text-center border-0 py-3">
                        <small class="text-muted">DualBid System</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Estilos para las tarjetas de selección de rol */
        .role-card {
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
            background: white;
            height: 100%;
            position: relative;
        }

        .role-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        .role-card.selected {
            border-color: #0d6efd;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.2);
        }

        .role-card.selected.buyer {
            border-color: #ffc107;
            background: linear-gradient(135deg, #fff9e6 0%, #fff3cd 100%);
        }

        .role-card.selected.seller {
            border-color: #0d6efd;
            background: linear-gradient(135deg, #e7f1ff 0%, #cfe2ff 100%);
        }

        .role-icon {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }

        .role-title {
            font-size: 1.25rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .role-description {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }

        .check-mark {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 1.2rem;
            display: none;
        }

        .role-card.selected .check-mark {
            display: block;
        }

        .role-card.selected.buyer .check-mark {
            color: #ffc107;
        }

        .role-card.selected.seller .check-mark {
            color: #0d6efd;
        }

        .role-card.buyer .role-icon {
            color: #ffc107;
        }

        .role-card.seller .role-icon {
            color: #0d6efd;
        }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <script>
        // Submit handling
        document.getElementById("registerForm").addEventListener("submit", function () {
            const btn = document.getElementById("btnRegister");
            const btnText = document.getElementById("btnText");
            const btnSpinner = document.getElementById("btnSpinner");

            btn.disabled = true;
            btnText.classList.add("d-none");
            btnSpinner.classList.remove("d-none");
        });

        // Toggle password visibility
        document.getElementById("togglePassword").addEventListener("click", function () {
            const passwordInput = document.getElementById("Password");
            const icon = this.querySelector("i");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                passwordInput.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        });

        // Toggle confirm password visibility
        document.getElementById("toggleConfirmPassword").addEventListener("click", function () {
            const confirmInput = document.getElementById("ConfirmPassword");
            const icon = this.querySelector("i");

            if (confirmInput.type === "password") {
                confirmInput.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                confirmInput.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        });

        // Manejar selección de tarjetas de rol
        document.addEventListener('DOMContentLoaded', function() {
            const roleCards = document.querySelectorAll('.role-card');
            const selectedRoleInput = document.getElementById('selectedRole');
            const descriptionSpan = document.getElementById("roleDescription");

            // Descripciones para cada rol
            const roleDescription = {
                2: '<i class="bi bi-shop-fill me-1"></i> As a seller, you will be able to create auctions and sell your products',
                3: '<i class="bi bi-cart-fill me-1"></i> As a buyer, you will be able to bid on products and make purchases'
            };

            roleCards.forEach(card => {
                card.addEventListener('click', function() {
                    // Remover selección de todas las tarjetas
                    roleCards.forEach(c => c.classList.remove('selected'));

                    // Agregar selección a la tarjeta actual
                    this.classList.add('selected');

                    // Obtener el valor del rol
                    const roleValue = this.getAttribute('data-role');
                    selectedRoleInput.value = roleValue;

                    // Actualizar la descripción
                    if (roleValue && roleDescription[roleValue]) {
                        descriptionSpan.innerHTML = roleDescription[roleValue];
                    } else {
                        descriptionSpan.innerHTML = '<i class="bi bi-info-circle-fill"></i> Select your account type';
                    }

                    // Disparar validación del campo oculto
                    const event = new Event('change', { bubbles: true });
                    selectedRoleInput.dispatchEvent(event);
                });
            });

            // Si hay un valor preseleccionado, marcar la tarjeta correspondiente
            if (selectedRoleInput.value) {
                const selectedCard = document.querySelector(`.role-card[data-role="${selectedRoleInput.value}"]`);
                if (selectedCard) {
                    selectedCard.classList.add('selected');
                    if (selectedRoleInput.value && roleDescription[selectedRoleInput.value]) {
                        descriptionSpan.innerHTML = roleDescription[selectedRoleInput.value];
                    }
                }
            }
        });
    </script>

    @if (TempData["Notificacion"] != null || ViewBag.Notificacion != null)
    {
        var notificacion = TempData["Notificacion"] ?? ViewBag.Notificacion;
        <script type="text/javascript">
            const payload = @Html.Raw(notificacion);
            if (payload) { Swal.fire(payload); }
        </script>
    }
</body>
</html>