@model DualBid.Application.DTOs.ComicDTO

@{
    ViewData["Title"] = "Details";
}

@* Esta es la sección de arriba arriba, esto es como las rutas de las páginas a las que ha accedido*@
<nav class="mb-5">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Inicio</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Comic" asp-action="Index" class="text-decoration-none">Cómics</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Detalle</li>
    </ol>
</nav>

@* Esta sección es la que tiene el bóton y contiene algunas etiquetas *@
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Details about the comic</h1>
        <p class="text-muted mb-0">About the selected comic.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Comic" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to catalog
        </a>
    </div>
</div>



@using System
@using System.Linq


@* Contenedor con toda la información del comic *@
<article class="card shadow-sm border-0 overflow-hidden">
    <div class="row g-0">

        @* Parte izquierda, la portada *@
        <div class="col-12 col-lg-5 border-end">
            @{
                var ListaImagenes = Model.ImgComic;
                var imgCuentaValid = ListaImagenes.Count(i => i.Img != null && i.Img.Length > 0);
                var tieneImagenes = imgCuentaValid > 0;
                var index = 0;
            }

            <div class="p-3">
                <div class="ratio ratio-4x3 bg-body-tertiary rounded-3 overflow-hidden">

                    @* Esto será true, solo si tiene almenos una imagen *@
                    @if (tieneImagenes)
                    {
                        <div id="carouselComic-@Model.Id" class="carousel slide w-100 h-100">
                            <div class="carousel-inner w-100 h-100">
                                @foreach (var img in ListaImagenes)
                                {
                                    @* esta condicion salta imagenes vacias *@
                                    if (img.Img == null || img.Img.Length == 0) { continue; }

                                    var base64 = Convert.ToBase64String(img.Img);
                                    var src = $"data:image/jpeg;base64,{base64}";

                                    <div class="carousel-item @(index == 0 ? "active" : "") w-100 h-100">
                                        <img src="@src" class="d-block w-100 h-100 object-fit-cover" />
                                    </div>

                                    index++;
                                }
                            </div>

                            @* Esto es por si hay varias imagenes entonces que aparezcan las flechas *@
                            @if (imgCuentaValid > 1)
                            {
                                <button class="carousel-control-prev" type="button"
                                        data-bs-target="#carouselComic-@Model.Id" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button"
                                        data-bs-target="#carouselComic-@Model.Id" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                            <div class="text-center">
                                <i class="bi bi-image fs-1"></i>
                                <div>No Cover</div>
                            </div>
                        </div>
                    }
                </div>


                @* Estas son las casillas con información sobre el comic  NO RELEVANTE *@
                <div class="mt-3 d-flex flex-wrap gap-2">
                    <span class="badge text-bg-light border"><i class="bi bi-hash me-1"></i>ID: @Model.Id</span>
                    <span class="badge text-bg-light border"><i class="bi bi-upc-scan me-1"></i><span class="font-monospace">@Model.Isbn</span></span>
                    <span class="badge text-bg-light border"><i class="bi bi-journal-bookmark me-1"></i>Edition: @Model.EditionNumber</span>
                    <span class="badge text-bg-light border"><i class="bi bi-calendar3 me-1"></i>Year: @Model.YearPublication</span>
                </div>
            </div>
        </div>




        @* Parte Derecha, la información del comic *@
        <div class="col-12 col-lg-7">
            <div class="card-body p-4">


                @* titulo *@
                <header class="mb-3">
                    <h2 class="h3 fw-bold mb-1">@Model.Title</h2>
                </header>

                <hr class="my-3" />


                @* Descripcion *@
                <section class="mb-4">
                    <h3 class="h6 text-uppercase text-muted mb-2">
                        <i class="bi bi-card-text me-1"></i> Description
                    </h3>

                    <div class="p-3 rounded-3 bg-body-tertiary border">
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="mb-0" style="white-space: pre-line;">@Model.Description</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No description available.</p>
                        }
                    </div>
                </section>


                @* Detalles del comic, ISBN, numero de edicion, Fecha de creación, año de publicación *@
                <section class="mb-4">
                    <h3 class="h6 text-uppercase text-muted mb-2">
                        <i class="bi bi-info-circle me-1"></i> Comic Details
                    </h3>

                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="small text-muted">ISBN</div>
                                <div class="fw-semibold font-monospace">@Model.Isbn</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="small text-muted">Edition Number</div>
                                <div class="fw-semibold">@Model.EditionNumber</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="small text-muted">Creation Date</div>
                                <div class="fw-semibold">@Model.CreationDate.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="small text-muted">Year of Publication</div>
                                <div class="fw-semibold">@Model.YearPublication</div>
                            </div>
                        </div>


                        @* Editorial y condición del comic *@
                        <div class="col-12">
                            <div class="row g-2">
                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-center gap-2 px-3 py-2 bg-white border rounded-pill shadow-sm h-100">
                                        <i class="bi bi-send text-primary"></i>
                                        <div>
                                            <div class="small text-muted">Publisher</div>
                                            <div class="fw-semibold">@(Model.Publisher.Description ?? "Not available")</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-center gap-2 px-3 py-2 bg-white border rounded-pill shadow-sm h-100">
                                        <i class="bi bi-stars text-warning"></i>
                                        <div>
                                            <div class="small text-muted">Condition</div>
                                            <div class="fw-semibold">@(Model.StateConservation.Description ?? "Not available")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>

                <hr class="my-4" />

                @* Botones finales, Editar y Volver al catalogo *@
                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
                    <a asp-controller="Comic" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </a>
                </div>

            </div>
        </div>

    </div>
</article>
