@model DualBid.Application.DTOs.ComicDTO

@{
    ViewData["Title"] = "Details";
}

@* Esta es la sección de arriba arriba *@
<nav class="mb-5">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Inicio</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Comic" asp-action="Index" class="text-decoration-none">Cómics</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Detalle</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Details about the comic</h1>
        <p class="text-muted mb-0">About the selected comic.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Comic" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to catalog
        </a>
    </div>
</div>



<article class="card shadow-sm border-0 overflow-hidden">
    <div class="row g-0">

        @* Portada *@
        <div class="col-12 col-lg-5 ">

            <div class="ratio ratio-4x3">
                <div class="d-flex flex-column justify-content-center align-items-center text-muted">
                    <i class="bi bi-image fs-1"></i>
                    <span class="small">No Cover</span>
                </div>
            </div>

           @*  Infor rápida *@
            <div class="p-3 border-top bg-body">
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge text-bg-light border">
                        <i class="bi bi-hash me-1"></i>ID: @Model.Id
                    </span>

                    <span class="badge text-bg-light border">
                        <i class="bi bi-upc-scan me-1"></i>
                        <span class="font-monospace">@Model.Isbn</span>
                    </span>

                    <span class="badge text-bg-light border">
                        <i class="bi bi-journal-bookmark me-1"></i>
                        Edition: @Model.EditionNumber
                    </span>

                    <span class="badge text-bg-light border">
                        <i class="bi bi-calendar3 me-1"></i>
                        Year: @Model.YearPublication
                    </span>
                </div>
            </div>

        </div>

         @* Contenido Comic *@ 
        <div class="col-12 col-lg-7">
            <div class="card-body p-4">

                 @* Titulo *@ 
                <header class="mb-3">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-start justify-content-between gap-3">
                            <div>
                                <h2 class="h3 fw-bold mb-1">
                                    @Model.Title
                                </h2>

                        </div>
                    </div>
                </header>

                <hr class="my-3" />

                 @* Description  *@
                <section class="mb-4">
                    <h3 class="h6 text-uppercase text-muted mb-2">
                        <i class="bi bi-card-text me-1"></i> Description
                    </h3>

                    <div class="p-3 rounded-3 bg-body-tertiary border">
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="mb-0" style="white-space: pre-line;">@Model.Description</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No description available.</p>
                        }
                    </div>
                </section>


                
                 @* Detalles Generales del comic  *@
                <section class="mb-4">
                    <h3 class="h6 text-uppercase text-muted mb-2">
                        <i class="bi bi-info-circle me-1"></i> Comic Details
                    </h3>

                    <div class="row g-2">

                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="small text-muted">ISBN</div>
                                <div class="fw-semibold font-monospace">@Model.Isbn</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="small text-muted">Edition Number</div>
                                <div class="fw-semibold">@Model.EditionNumber</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="small text-muted">Creation Date</div>
                                <div class="fw-semibold">@Model.CreationDate.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="small text-muted">Year of Publication</div>
                                <div class="fw-semibold">@Model.YearPublication</div>
                            </div>
                        </div>


                        @* Informacion de las tablas relacionadas *@
                        <div class="col-12">
                            <div class="p-3">

                                <div class="d-flex flex-wrap gap-3">

                                    @* año de publicaciones *@
                                    <div class="d-flex align-items-center gap-2 px-3 py-2 bg-white border rounded-pill shadow-sm">
                                        <i class="bi bi-send text-primary"></i>

                                        <div>
                                            <div class="small text-muted">Publisher</div>
                                            <div class="fw-semibold">
                                                @(Model.Publisher.Description ?? "Not available")
                                            </div>
                                        </div>
                                    </div>

                                    @* Condición *@
                                    <div class="d-flex align-items-center gap-2 px-3 py-2 bg-white border rounded-pill shadow-sm">
                                        <i class="bi bi-stars text-warning"></i>

                                        <div>
                                            <div class="small text-muted">Condition</div>
                                            <div class="fw-semibold">
                                                @(Model.StateConservation.Description ?? "Not available")
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>


                    </div>
                </section>

                <hr class="my-4" />

                 @* Acciones *@ 
                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
                    <a asp-controller="Comic" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>

                    <a asp-controller="Comic" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </a>
                </div>

            </div>
        </div>

    </div>
</article>
