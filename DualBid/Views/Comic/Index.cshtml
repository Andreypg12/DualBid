@model IEnumerable<DualBid.Application.DTOs.ComicDTO>

@{
    ViewData["Title"] = "Catálogo de libros";
    var total = Model?.Count() ?? 0;
}

<div class="container-fluid px-3 px-lg-4 mt-3">

    @* Header principal con todas las tarjetas *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-3 border-bottom">

        @* Lado izquierdo con título, contador y filtros *@
        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-3 gap-sm-4">

            @* Titulo y contador *@
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 p-3 rounded-3 d-none d-sm-block">
                    <i class="bi bi-collection-fill text-primary fs-4"></i>
                </div>
                <div>
                    <h1 class="h3 fw-semibold text-dark mb-1">Comic Catalog</h1>
                    <p class="text-secondary small mb-0 d-flex align-items-center flex-wrap">
                        <span class="fw-semibold text-dark ms-1">Total items: @total</span>
                    </p>
                </div>
            </div>

            @* Filtros de estados *@
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary small fw-medium me-1">Status:</span>
                <div class="d-flex gap-2">

                    @* Boton available *@
                    <a asp-action="Index" asp-route-availability="available"
                       class="text-decoration-none px-3 py-2 rounded-3 d-inline-flex align-items-center gap-2"
                       style="font-size: 0.9rem; transition: all 0.2s;
                              @(ViewBag.SelectedAvailability == "available" ? "background-color: #e8f5e9; color: #2e7d32; border: 1px solid #2e7d32;" : "background-color: #f5f5f5; color: #666; border: 1px solid #e0e0e0;")">
                        <span class="rounded-circle" style="width: 8px; height: 8px; @(ViewBag.SelectedAvailability == "available" ? "background-color: #2e7d32;" : "background-color: #999;")"></span>
                        <span>Available</span>
                    </a>

                    @* Boton Unvailable *@
                    <a asp-action="Index" asp-route-availability="unavailable"
                       class="text-decoration-none px-3 py-2 rounded-3 d-inline-flex align-items-center gap-2"
                       style="font-size: 0.9rem; transition: all 0.2s;
                              @(ViewBag.SelectedAvailability == "unavailable" ? "background-color: #ffebee; color: #c62828; border: 1px solid #c62828;" : "background-color: #f5f5f5; color: #666; border: 1px solid #e0e0e0;")">
                        <span class="rounded-circle" style="width: 8px; height: 8px; @(ViewBag.SelectedAvailability == "unavailable" ? "background-color: #c62828;" : "background-color: #999;")"></span>
                        <span>Unavailable</span>
                    </a>
                </div>
            </div>
        </div>

        @*  Lado derecho *@
        <div class="d-flex gap-2">

            @* Boton de crear *@
            <a asp-controller="Comic" asp-action="Create"
               class="btn btn-sm d-inline-flex align-items-center gap-2 px-4 py-2 rounded-3 fw-medium"
               style="background-color: #e3f2fd; color: #1976d2; border: 1px solid #1976d2; transition: all 0.2s;">
                <i class="bi bi-plus-circle" style="font-size: 0.9rem;"></i>
                <span>Create New</span>
            </a>
            @* Boton de volver  *@
            <a asp-controller="Home" asp-action="Index"
               class="btn btn-sm d-inline-flex align-items-center gap-2 px-4 py-2 rounded-3 fw-medium"
               style="background-color: #fee2e2; color: #b91c1c; border: 1px solid #b91c1c; transition: all 0.2s;">
                <i class="bi bi-arrow-left" style="font-size: 0.9rem;"></i>
                <span>Back Home</span>
            </a>
        </div>
    </div>
</div>


@if (Model == null || !Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div>There is not Comics Available yet.</div>
    </div>
}
else
{
    <section aria-label="List of comics">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">


                    <article class="card h-100 border-0 shadow-sm hover-shadow transition-all">


                        @* Imagen *@
                        <div class="position-relative rounded-top overflow-hidden" style="height: 280px;">
                            @if (item.ImgComic != null && item.ImgComic.Any())
                            {
                                var imgSola = item.ImgComic.FirstOrDefault();
                                <img class="w-100 h-100 object-fit-cover transition-transform hover-scale"
                                     src="data:image/jpeg;base64,@Convert.ToBase64String(imgSola.Img)"
                                     alt="Portada del libro @item.Title"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex flex-column justify-content-center align-items-center text-muted bg-light">
                                    <i class="bi bi-image fs-1 mb-2"></i>
                                    <span class="small fw-medium">No cover</span>
                                </div>
                            }


                            @* Estado de conservación sobre la imagen *@
                            <span class="position-absolute top-0 end-0 m-3 badge bg-@(item.StateConservation?.Description?.ToLower() == "nuevo" ? "success" : "warning") bg-opacity-90 rounded-pill px-3 py-2">
                                <i class="bi bi-stars me-1"></i>
                                @(item.StateConservation?.Description ?? "Estado no disponible")
                            </span>
                        </div>

                        @* Contenido de la tarjeta *@
                        <div class="card-body bg-white">


                            @* Titulo *@
                            <div class="mb-3">

                                <h3 class="h5 fw-bold text-dark mb-2 text-truncate" title="@item.Title">
                                    @item.Title
                                </h3>

                            </div>

                            @* Categorias *@ 
                                    @if (item.Category != null && item.Category.Any())
                            {
                                <div class="mb-3">
                                    <div class="d-flex align-items-center gap-2 mb-2 text-dark">
                                        <i class="bi bi-tags fs-6"></i>
                                        <span class="small fw-semibold">Categories</span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var category in item.Category)
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-normal">
                                                <i class="bi bi-asterisk text-warning me-1"></i>
                                                @category.Description
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Acciones con diseño mejorado -->
                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">

                            <div class="d-flex justify-content-end gap-2">

                                @* Ojo de detalles *@
                                <a asp-controller="Comic" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning rounded-circle d-flex align-items-center justify-content-center"
                                   style="width: 36px; height: 36px; background-color: rgb(104, 119, 224)"
                                   title="View details"
                                   data-action="btn-edit">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @* Boton de editar *@
                                <a asp-controller="Comic" asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center btn-edit"
                                   data-auctions="@item.AuctionCount"
                                   data-availability="@item.availability"
                                   style="width: 36px; height: 36px; background-color: rgb(179, 216, 252)">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                @if (item.availability)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" class="delete-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center"
                                                style="width: 36px; height: 36px; background-color: rgb(219, 77, 74)"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Restore" asp-route-id="@item.Id" method="post" style="display:inline;" class="restore-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center"
                                                style="width: 36px; height: 36px; background-color: rgb(148, 230, 137)"
                                                title="Restore">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </form>
                                }

                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>
}

@section Scripts {

    <script>

        //BORRAR
                document.querySelectorAll('.delete-form').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                const comicTitle =
                    this.closest('.card')?.querySelector('h3')?.innerText || 'this comic';

                Swal.fire({
                    title: 'Delete comic?',
                    text: `Are you sure you want to delete "${comicTitle}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: 'rgb(176, 212, 247)',
                    cancelButtonColor: 'rgb(215, 75, 72)',
                    confirmButtonText: 'Yes',
                    cancelButtonText: 'No'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
        //TERMINA BORRAR


        //RESTORE
                document.querySelectorAll('.restore-form').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                const comicTitle =
                    this.closest('.card')?.querySelector('h3')?.innerText || 'this comic';

                Swal.fire({
                    title: 'Restore comic?',
                    text: `Are you sure you want to restore "${comicTitle}"?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: 'rgb(176, 212, 247)',
                    cancelButtonColor: 'rgb(215, 75, 72)',
                    confirmButtonText: 'Yes',
                    cancelButtonText: 'No'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
        //TERMINA RESTORE



        // EDITAR
            document.querySelectorAll('.btn-edit').forEach(button => {

            button.addEventListener('click', function (e) {

                e.preventDefault();;

                let auctions = button.getAttribute('data-auctions');
                let availabilityTest = button.getAttribute('data-availability')

                // Tiene subasta Entonces no funciona
                if (auctions > 0 || availabilityTest == false) {

                    Swal.fire({
                        title: "Cannot edit comic",
                        text: "The comic is already in an active auction or has already been auctioned.",
                        icon: "error",
                        confirmButtonColor: "rgb(215, 75, 72)"
                    });

                    return;
                }

                //  No tiene subasta entonces preguntar si quiere editar
                Swal.fire({
                    title: 'Edit comic?',
                    text: 'You will be redirected to the edit form',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: 'rgb(176, 212, 247)',
                    cancelButtonColor: 'rgb(215, 75, 72)',
                    confirmButtonText: 'Yes',
                    cancelButtonText: 'No'
                }).then((result) => {

                    if (result.isConfirmed) {
                        window.location.href = this.href;
                    }

                });

            });

        });
        // Termina EDITAR
    </script>


    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        a, .btn {
            transition: all 0.2s ease !important;
        }

            a[asp-route-availability]:hover, .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.08);
            }

            .btn:hover {
                filter: brightness(0.98);
            }

        .rounded-circle {
            display: inline-block;
            flex-shrink: 0;
        }

        .border-bottom {
            border-color: #eaeef2 !important;
        }

        .small {
            font-size: 0.875rem;
        }

        .h3 {
            font-size: 1.75rem;
        }
    </style>
}

