@model IEnumerable<DualBid.Application.DTOs.ComicDTO>

@{
	ViewData["Title"] = "Catálogo de libros";
	var total = Model?.Count() ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
	<div>
		<h1 class="h3 mb-1">Catálogo de libros</h1>
		<p class="text-muted mb-0">Explora el catálogo disponible. Total: <strong>@total</strong>.</p>
	</div>

	 <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index"
           class="btn btn-outline-secondary">
			<i class="bi bi-arrow-return-left mb-1"></i> Back home
        </a>
    </div> 

</div>

@if (Model == null || !Model.Any())
{
	<div class="alert alert-info d-flex align-items-center" role="alert">
		<i class="bi bi-info-circle me-2"></i>
		<div>There is not Comics Available yet.</div>
	</div>
}
else
{
	<section aria-label="List of comics">
		<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 ">

			@foreach (var item in Model)
			{
				<div class="col">
					<article class="card h-100 shadow-lg">
						<!-- Imagen -->
						<div class="rounded-top overflow-hidden bg-body-tertiary" style="height: 360px;">
							@* Si hay imagen, la mostramos; si no, placeholder *@
							@if (item.ImgComic != null && item.ImgComic.Any())
							{
								var imgSola = item.ImgComic.FirstOrDefault();

								<img class="w-100 h-100 object-fit-cover  rounded-top"
									 src="data:image/jpeg;base64,@Convert.ToBase64String(imgSola.Img)"
									 alt="Portada del libro @item.Title"
									 loading="lazy" />
							}
							else
							{
								<div class="ratio ratio-4x3">
									<div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
										<i class="bi bi-image fs-1"></i>
										<span class="small">No Cover</span>
									</div>
								</div>
							}
						</div>



						@* Nombre,descripcion, editorial, estado de conservación *@
						<div class="card-body bg-light text-center ">
							<h2 class="h6 fw-semibold mb-1 text-truncate" title="@item.Title">
								@item.Title
							</h2>

							<div class="d-flex flex-wrap gap-2 align-items-center mb-2">
								<span class="badge text-bg-light border">
									<i class="bi bi-person me-1"></i>
									@(item.Publisher?.Description ?? "Publisher no available")
								</span>

								<span class="badge text-bg-light border">
									<i class="bi bi-person me-1"></i>
									@(item.StateConservation?.Description ?? "State of conservation no availabe")
								</span>
							</div>
						</div>


							@* Acciones *@						
							<div class="d-flex justify-content-center gap-2 pb-2 bg-light ">

								<a asp-controller="Comic" asp-action="Details" asp-route-id="@item.Id"
								   class="btn btn-sm btn-outline-warning" title="Details">
									<i class="bi bi-eye"></i>
								</a>

								<a class="btn btn-sm btn-outline-primary" title="Edit">
									<i class="bi bi-pencil-square"></i>
								</a>

								<a class="btn btn-sm btn-outline-danger" title="Delete">
									<i class="bi bi-trash"></i>
								</a>
							</div>
						
					</article>
				</div>
			}

		</div>
	</section>
}

@section Scripts {
	<style>
		.card:hover {
			transform: translateY(-3px);
			transition: transform .18s ease;
		}
	</style>
}