@model DualBid.Application.DTOs.UserDTO

<div class="container my-5">
    <div class="card profile-card border-0 rounded-4 overflow-hidden shadow-lg">

        <!-- Header -->
        <div class="profile-header text-white px-4 py-5">
            <div class="d-flex flex-wrap align-items-center gap-4">
                <!-- Avatar -->
                <div class="profile-avatar">
                    <i class="bi bi-person-fill fs-1"></i>
                </div>
                <!-- Name & badges -->
                <div class="flex-grow-1">
                    <h2 class="mb-1 fw-bold">@Model.CompleteName</h2>
                    <p class="mb-2 opacity-75">
                        <i class="bi bi-envelope-at me-1"></i>@Model.Email
                    </p>
                </div>
                <!-- Registration date-->
                <div class="text-end d-none d-md-block">
                    <small class="d-block opacity-75">Member since</small>
                    <span class="fw-semibold">
                        <i class="bi bi-calendar3 me-1"></i>
                        @Model.RegistrationDate.ToString("dd MMM yyyy")
                    </span>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="card-body p-4">
            <div class="row g-4">
                <!-- Role -->
                <div class="col-sm-6 col-lg-4">
                    <div class="stat-card">
                        <div class="stat-card-icon text-primary">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <span class="stat-label">Role</span>
                            <span class="stat-value">@Model.Role.Description</span>
                        </div>
                    </div>
                </div>

                <!-- Status con estilos dinámicos -->
                <div class="col-sm-6 col-lg-4">
                    @{
                        string StatusColor = Model.State?.Id switch
                        {
                            1 => "success",
                            2 => "black",
                            3 => "danger",
                            0 => "warning",
                            _ => "info"
                        };

                        string StatusIcon = Model.State?.Id switch
                        {
                            1 => "bi-check2-circle",
                            2 => "bi-slash-circle",
                            3 => "bi-shield-lock",
                            0 => "bi-hourglass-split",
                            _ => "bi-question-circle"
                        };
                    }

                    <div class="stat-card" style="border-left: 4px solid var(--bs-@StatusColor);">
                        <div class="stat-card-icon text-@StatusColor">
                            <i class="bi @StatusIcon"></i>
                        </div>
                        <div>
                            <span class="stat-label">Status</span>
                            <span class="stat-value">
                                <span class="badge bg-@StatusColor bg-opacity-10 text-@StatusColor px-3 py-2 rounded-pill">
                                    @Model.State?.Description
                                </span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Auctions y Bids -->
                <div class="col-sm-12 col-lg-4">
                    @if (Model.Role.Id == 2)
                    {
                        <div class="stat-card">
                            <div class="stat-card-icon text-warning">
                                <i class="bi bi-hammer"></i>
                            </div>
                            <div>
                                <span class="stat-label">Auctions created</span>
                                <span class="stat-value">@Model.NumberOfAuctions</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="stat-card">
                            <div class="stat-card-icon text-info">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div>
                                <span class="stat-label">Bids placed</span>
                                <span class="stat-value">@Model.NumberOfBids</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- Registration date-->
                <div class="col-12 d-md-none">
                    <div class="stat-card">
                        <div class="stat-card-icon text-secondary">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <div>
                            <span class="stat-label">Member since</span>
                            <span class="stat-value">@Model.RegistrationDate.ToString("dd MMM yyyy • HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#editUserModal">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </button>
            </div>
        </div>
    </div>

    <!-- Modal de edición -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-gradient-primary text-white border-0">
                    <h5 class="modal-title fw-semibold" id="editUserModalLabel">
                        <i class="bi bi-pencil-square me-2"></i>Edit User
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form asp-action="Edit" method="post" id="editUserForm">
                        <input type="hidden" asp-for="Id" id="edit_Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Name</label>
                            <input asp-for="Name" class="form-control" id="edit_Name" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastNames" class="form-label fw-semibold">Last Names</label>
                            <input asp-for="LastNames" class="form-control" id="edit_LastNames" required />
                            <span asp-validation-for="LastNames" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control" id="edit_Email" type="email" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Combo de Estados -->
                        <div class="mb-3">
                            <label asp-for="StateId" class="form-label fw-semibold">Status</label>
                            <select asp-for="StateId" class="form-select" id="edit_StateId" required>
                                <option value="">Select a status</option>
                                @if (ViewBag.States != null)
                                {
                                    foreach (var state in ViewBag.States)
                                    {
                                        <option value="@state.Id">@state.Description</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="StateId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-check2-circle me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Header inicio */
    .profile-header {
        background: linear-gradient(135deg, #0d6efd 0%, #6f42c1 100%);
        position: relative;
    }

        .profile-header::after {
            content: "";
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            pointer-events: none;
        }
    /* Header fin */

    /* Avatar inicio */
    .profile-avatar {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        background: rgba(255, 255, 255, .15);
        backdrop-filter: blur(6px);
        border: 2px solid rgba(255, 255, 255, .25);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    /* Avatar fin */


    /* Stat cards inicio*/
    .stat-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 20px;
        border-radius: 16px;
        background: #f8f9fb;
        border: 1px solid #eef1f5;
        height: 100%;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0, 0, 0, .06);
        }

    .stat-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: color-mix(in srgb, currentColor 12%, transparent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .stat-label {
        display: block;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6c757d;
        font-weight: 600;
    }

    .stat-value {
        display: block;
        font-size: 1.15rem;
        font-weight: 700;
        color: #212529;
    }
    /* Stat cards fin */


    /* Card global */
    .profile-card {
        transition: box-shadow .2s ease;
    }

        .profile-card:hover {
            box-shadow: 0 12px 40px rgba(0, 0, 0, .1) !important;
        }
</style>

@section Scripts {
    <script>
                document.addEventListener('DOMContentLoaded', function() {
            const editModal = document.getElementById('editUserModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function () {
                    document.getElementById('edit_Id').value = '@Model.Id';
                    document.getElementById('edit_Name').value = '@Model.Name';
                    document.getElementById('edit_LastNames').value = '@Model.LastNames';
                    document.getElementById('edit_Email').value = '@Model.Email';

                    const stateSelect = document.getElementById('edit_StateId');
                    if (stateSelect) {
                        stateSelect.value = '@(Model.State?.Id ?? 0)';
                    }
                });
            }
        });
    </script>
}