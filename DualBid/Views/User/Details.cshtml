@model DualBid.Application.DTOs.UserDTO

<div class="container mt-5 w-75">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <!-- Header -->
        <div class="card-header text-white"
             style="background: linear-gradient(135deg, #1f2933, #111827);">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-vcard fs-2 me-3"></i>
                <div>
                    <h4 class="mb-0">User Profile</h4>
                </div>
            </div>
        </div>
        <!-- State -->
        <div class="text-end">
            @await Html.PartialAsync("_UserStatusBadge", Model.State)
        </div>
        <!-- Body -->
        <div class="card-body p-4">
            <div class="row align-items-center">

                <!-- Avatar and date -->
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    <div class="d-flex flex-column align-items-center gap-2">

                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                             style="width:120px; height:120px; border:4px solid #dee2e6;">
                            <i class="bi bi-person-fill fs-1 text-secondary"></i>
                        </div>

                        <div class="text-muted small">
                            Registration date <br />
                            <i class="bi bi-calendar-event"></i>
                            @Model.RegistrationDate.ToString("dd MMM yyyy • HH:mm")
                        </div>
                    </div>
                </div>

                <!-- User info -->
                <div class="col-md-8 flex-column">

                    <h3 class="fw-bold mb-1">
                        @Model.Name @Model.LastNames
                    </h3>

                    <p class="text-muted mb-2">
                        <i class="bi bi-envelope-at"></i> @Model.Email
                    </p>

                    <div class="d-flex justify-content-center justify-content-md-start gap-2 mb-2">
                        <!-- Role -->
                        @await Html.PartialAsync("_RoleBadge", Model.Role)
                    </div>

                    @if (Model.Role.Id == 2)
                    {
                        <div>
                            <i class="bi bi-hammer"></i>
                            Number of auctions: <strong>@Model.Auctions.Count</strong>
                        </div>
                    }
                    else
                    {
                        <div>
                            <i class="bi bi-cash-coin"></i>
                            Number of bids: <strong>@Model.Bids.Count</strong>
                        </div>
                    }
                </div>

            </div>

            <hr />
        </div>

        <!-- FOOTER -->
        <div class="card-footer bg-light d-flex justify-content-end gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>
