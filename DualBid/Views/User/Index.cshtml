@model IEnumerable<DualBid.Application.DTOs.UserDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-hover align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>
                <i class="bi bi-person-badge"></i> User
            </th>
            <th class="text-center">
                <i class="bi bi-people"></i> Role
            </th>
            <th class="text-center">
                <i class="bi bi-shield-check"></i> Status
            </th>
            <th class="text-center">
                <i class="bi bi-gear"></i> Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <!-- Complete name -->
                <td class="fw-semibold">
                    <i class="bi bi-person-circle text-primary"></i>
                    @item.CompleteName
                </td>

                <!-- Role -->
                <td class="text-center">
                    @await Html.PartialAsync("_RoleBadge", item.Role)
                </td>

                <!-- State -->
                

                <td class="text-center">
                    @await Html.PartialAsync("_UserStatusBadge", item.State)
                </td>

                <!-- Actions -->
                <td class="text-center">
                    <a asp-controller="User"
                       asp-action="Details"
                       asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Details">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a class="btn btn-sm btn-outline-primary" title="Edit">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <a class="btn btn-sm btn-outline-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
