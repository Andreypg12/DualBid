@model X.PagedList.IPagedList<DualBid.Application.DTOs.UserDTO>
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-hover align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>
                <i class="bi bi-person-badge"></i> User
            </th>
            <th class="text-center">
                <i class="bi bi-people"></i> Role
            </th>
            <th class="text-center">
                <i class="bi bi-shield-check"></i> Status
            </th>
            <th class="text-center">
                <i class="bi bi-gear"></i> Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <!-- Complete name -->
                <td class="fw-semibold">
                    <i class="bi bi-person-circle text-primary"></i>
                    @item.CompleteName
                </td>

                <!-- Role -->
                <td class="text-center">
                    @await Html.PartialAsync("_RoleBadge", item.Role)
                </td>

                <!-- State -->


                <td class="text-center">
                    @await Html.PartialAsync("_UserStatusBadge", item.State)
                </td>

                <!-- Actions -->
                <td class="text-center">
                    <a asp-controller="User"
                       asp-action="Details"
                       asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Details">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a class="btn btn-sm btn-outline-primary" title="Edit">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <a class="btn btn-sm btn-outline-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Paginación *@
@if (Model != null && Model.PageCount > 1)
{
    <div class="card-footer bg-body d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
        <div class="small text-muted">
            Page <strong>@Model.PageNumber</strong> of <strong>@Model.PageCount</strong>
        </div>

        <nav aria-label="User pagination">
            @Html.PagedListPager(
            Model,
                page => Url.Action("Index", new { page }),
                new PagedListRenderOptions
                {
                    UlElementClasses = new[] { "pagination", "mb-0" },
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" },

                    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                    DisplayLinkToLastPage = PagedListDisplayMode.Always,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always,

                    MaximumPageNumbersToDisplay = 5
                }
                )
    </nav>
</div>
        }
