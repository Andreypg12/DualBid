@model DualBid.Application.DTOs.UserProfileEditDTO
@{
    ViewData["Title"] = "My Profile";
    bool isEditing = ViewBag.IsEditing ?? false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                
                <!-- Header con gradiente según rol -->
                <div class="profile-header @(Model.RoleId == 1 ? "bg-gradient-admin" : (Model.RoleId == 2 ? "bg-gradient-seller" : "bg-gradient-user")) text-white px-4 py-5">
                    <div class="d-flex flex-wrap align-items-center gap-4">
                        <div class="profile-avatar">
                            @{
                                string avatarIcon = Model.RoleId == 1 ? "bi-shield-lock-fill" : (Model.RoleId == 2 ? "bi-hammer" : "bi-person-fill");
                            }
                            <i class="bi @avatarIcon fs-1"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h2 class="mb-1 fw-bold">@Model.Name @Model.LastNames</h2>
                            <p class="mb-2 opacity-75">
                                <i class="bi bi-envelope-at me-1"></i> @Model.Email
                            </p>
                            <div class="d-flex gap-2 mt-2">
                                @{
                                    string roleBadgeClass = Model.RoleId == 1 ? "bg-light text-primary" : (Model.RoleId == 2 ? "bg-warning text-dark" : "bg-info text-dark");
                                    string roleIcon = Model.RoleId == 1 ? "bi-shield-check" : (Model.RoleId == 2 ? "bi-cart" : "bi-person");
                                }
                                <span class="badge @roleBadgeClass px-3 py-2 rounded-pill">
                                    <i class="bi @roleIcon me-1"></i> @Model.RoleDescription
                                </span>
                                
                                @{
                                    string stateBadgeClass = Model.StateDescription == "Active" ? "bg-success" : (Model.StateDescription == "Inactive" ? "bg-secondary" : "bg-danger");
                                }
                                <span class="badge @stateBadgeClass px-3 py-2 rounded-pill">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> @Model.StateDescription
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (!isEditing)
                    {
                        <!-- MODO VISUALIZACIÓN -->
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="info-card">
                                    <div class="info-icon text-primary"><i class="bi bi-person-badge"></i></div>
                                    <div>
                                        <span class="info-label">Full Name</span>
                                        <span class="info-value">@Model.Name @Model.LastNames</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-card">
                                    <div class="info-icon text-info"><i class="bi bi-envelope"></i></div>
                                    <div>
                                        <span class="info-label">Email Address</span>
                                        <span class="info-value">@Model.Email</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-card">
                                    <div class="info-icon text-warning"><i class="bi bi-key"></i></div>
                                    <div>
                                        <span class="info-label">Password</span>
                                        <span class="info-value text-muted">··········</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-house-door me-1"></i> Dashboard
                            </a>
                            <a asp-action="MyProfile" asp-route-edit="true" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-pencil-square me-1"></i> Edit Profile
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- MODO EDICIÓN -->
                        <form asp-action="UpdateProfile" method="post" id="profileForm">
                            @Html.AntiForgeryToken()
                            
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
                            
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Name" class="form-control" placeholder="Name" />
                                        <label asp-for="Name"><i class="bi bi-person me-1"></i> Name</label>
                                    </div>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="LastNames" class="form-control" placeholder="Last Names" />
                                        <label asp-for="LastNames"><i class="bi bi-person-lines-fill me-1"></i> Last Names</label>
                                    </div>
                                    <span asp-validation-for="LastNames" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="Email" class="form-control" placeholder="Email" type="email" />
                                        <label asp-for="Email"><i class="bi bi-envelope me-1"></i> Email</label>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                    <small class="text-muted">Changing your email will update your login credentials</small>
                                </div>
                                
                                <div class="col-12">
                                    <div class="form-floating bg-light">
                                        <input asp-for="RoleDescription" class="form-control bg-light" readonly disabled />
                                        <label class="text-muted"><i class="bi bi-shield-check me-1"></i> Role (cannot be changed)</label>
                                    </div>
                                    <small class="text-muted">Role cannot be modified. Contact an administrator if needed.</small>
                                </div>
                                
                                <div class="col-12">
                                    <hr class="my-2" />
                                    <h6 class="text-muted mb-3"><i class="bi bi-lock me-2"></i> Change Password (optional)</h6>
                                    <small class="text-muted d-block mb-3">Leave blank if you don't want to change your password</small>
                                </div>
                                
                                <div class="col-md-12">
                                    <div class="form-floating">
                                        <input asp-for="CurrentPassword" class="form-control" placeholder="Current Password" type="password" />
                                        <label asp-for="CurrentPassword"><i class="bi bi-key me-1"></i> Current Password</label>
                                    </div>
                                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                                    <small class="text-muted">Required only if you want to change your password</small>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="NewPassword" class="form-control" placeholder="New Password" type="password" />
                                        <label asp-for="NewPassword"><i class="bi bi-key-fill me-1"></i> New Password</label>
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                    <small class="text-muted">Minimum 6 characters</small>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Confirm New Password" type="password" />
                                        <label asp-for="ConfirmNewPassword"><i class="bi bi-key-fill me-1"></i> Confirm Password</label>
                                    </div>
                                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                                <a asp-action="MyProfile" class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary rounded-pill px-4" id="submitBtn">
                                    <i class="bi bi-check2-circle me-1"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-admin { background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%); }
    .bg-gradient-seller { background: linear-gradient(135deg, #fd7e14 0%, #dc3545 100%); }
    .bg-gradient-user { background: linear-gradient(135deg, #20c997 0%, #0dcaf0 100%); }
    
    .profile-avatar {
        width: 80px; height: 80px; border-radius: 20px;
        background: rgba(255, 255, 255, .15);
        backdrop-filter: blur(6px);
        border: 2px solid rgba(255, 255, 255, .25);
        display: flex; align-items: center; justify-content: center;
    }
    .profile-avatar i { font-size: 2.5rem; }
    
    .info-card {
        display: flex; align-items: center; gap: 14px;
        padding: 18px 20px; border-radius: 16px;
        background: #f8f9fb; border: 1px solid #eef1f5;
        transition: all 0.2s ease;
    }
    .info-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,0.06); }
    
    .info-icon {
        width: 48px; height: 48px; border-radius: 14px;
        background: rgba(13, 110, 253, 0.1);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
    }
    .info-label { display: block; font-size: .72rem; text-transform: uppercase; color: #6c757d; font-weight: 600; }
    .info-value { display: block; font-size: 1rem; font-weight: 600; color: #212529; }
    .rounded-4 { border-radius: 1rem !important; }
    
    .form-floating > input:focus, .form-floating > input:not(:placeholder-shown) {
        padding-top: 1.5rem; padding-bottom: 0.5rem;
    }
    
    .btn-loading {
        opacity: 0.7;
        pointer-events: none;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Prevenir doble envío del formulario
        document.getElementById('profileForm')?.addEventListener('submit', function() {
            const submitBtn = document.getElementById('submitBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.classList.add('btn-loading');
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
            }
        });
    </script>
}