@model DualBid.ViewModels.Bid.CreateBidViewModel

@{
    ViewData["Title"] = "Create bid";
}

<div class="container py-5">
    <!-- Header con diseño mejorado -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 fw-bold mb-1 text-primary">
                        <i class="bi bi-gavel me-2"></i>
                        @Model.TitleComicAuction
                    </h1>

                    <p class="text-secondary mb-0">
                        <i class="bi bi-cash-stack me-1"></i> Create a new bid
                    </p>
                </div>

                <!-- Badge de información de la subasta -->
                <div class="d-flex gap-2">
                    <div class="bg-light rounded-3 p-3 text-center">
                        <small class="text-muted d-block">Current bid</small>
                        <span class="h5 mb-0 text-success fw-bold">$@Model.CurrentBidPrice.ToString("N2")</span>
                    </div>
                    <div class="bg-light rounded-3 p-3 text-center">
                        <small class="text-muted d-block">Min. increase</small>
                        <span class="h5 mb-0 text-primary fw-bold">$@Model.MinimunIncrease.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna izquierda - Formulario -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" id="bidForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Campos ocultos para los IDs -->
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="AuctionId" />
                        <input type="hidden" asp-for="TitleComicAuction" />
                        <input type="hidden" asp-for="MinimunIncrease" id="hiddenMinIncrease" />
                        <input type="hidden" asp-for="CurrentBidPrice" id="hiddenCurrentBid" />

                        <!-- Campo de monto a ofrecer -->
                        <div class="mb-4">
                            <label asp-for="AmountOffered" class="form-label fw-semibold">
                                <i class="bi bi-cash me-1"></i> Your bid amount
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-end-0">$</span>
                                <input asp-for="AmountOffered"
                                       class="form-control form-control-lg border-start-0 ps-0"
                                       placeholder="0.00"
                                       id="amountOffered"
                                       autocomplete="off" />
                            </div>
                            <span asp-validation-for="AmountOffered" class="text-danger small"></span>

                            <!-- Información de validación en tiempo real -->
                            <div id="bidValidationMessage" class="mt-2 small"></div>

                            <!-- Botones de monto sugerido -->
                            <div class="mt-3">
                                <label class="form-label small text-muted mb-2">Suggested amounts:</label>
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="button" class="btn btn-outline-primary rounded-pill px-3" id="suggestedBidBtn">
                                        <i class="bi bi-lightning-charge me-1"></i>
                                        Suggested: $<span id="suggestedAmount">@((Model.CurrentBidPrice + Model.MinimunIncrease).ToString("N2"))</span>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" id="customAmountBtn" data-bs-toggle="modal" data-bs-target="#amountModal">
                                        <i class="bi bi-pencil me-1"></i> Custom amount
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Información de la puja actual -->
                        <div class="alert alert-info bg-light border-0 rounded-3 mb-4">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-primary bg-opacity-10 rounded-2 p-2">
                                    <i class="bi bi-info-circle-fill text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="fw-semibold mb-1">Bidding information</h6>
                                    <p class="small text-black mb-0">
                                        The current bid is <strong class="text-success">$@Model.CurrentBidPrice.ToString("N2")</strong>.
                                        To place a valid bid, you must offer at least <strong class="text-primary">$@((Model.CurrentBidPrice + Model.MinimunIncrease).ToString("N2"))</strong>
                                        (current bid + minimum increase of <strong>$@Model.MinimunIncrease.ToString("N2")</strong>).
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-flex gap-3 align-items-center">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 px-4" id="submitBtn">
                                <i class="bi bi-check2-circle me-2"></i>Place bid
                            </button>

                            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-3 px-4">
                                <i class="bi bi-arrow-left me-2"></i>Go back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Columna derecha - Información adicional -->
        <div class="col-lg-5">
            <!-- Tarjeta de resumen de la subasta -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title fw-semibold mb-3">
                        <i class="bi bi-pie-chart me-2"></i>Bid summary
                    </h5>

                    <div class="vstack gap-3">
                        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom">
                            <span class="text-secondary">Current bid</span>
                            <span class="fw-bold text-success fs-5">$@Model.CurrentBidPrice.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom">
                            <span class="text-secondary">Minimum increase</span>
                            <span class="fw-bold text-primary">+$@Model.MinimunIncrease.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-secondary fw-semibold">Minimum required</span>
                            <span class="fw-bold text-dark fs-4">$@((Model.CurrentBidPrice + Model.MinimunIncrease).ToString("N2"))</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta de consejos -->
            <div class="card border-0 bg-primary bg-gradient text-white rounded-4">
                <div class="card-body p-4">
                    <h5 class="card-title fw-semibold mb-3">
                        <i class="bi bi-lightbulb me-2"></i>Bidding tips
                    </h5>
                    <ul class="list-unstyled mb-0 vstack gap-2">
                        <li class="d-flex gap-2">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <span>Make sure your bid is higher than the current one</span>
                        </li>
                        <li class="d-flex gap-2">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <span>Remember to include the minimum increase of $@Model.MinimunIncrease.ToString("N2")</span>
                        </li>
                        <li class="d-flex gap-2">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <span>Use the suggested amount button for a valid bid</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para monto personalizado -->
<div class="modal fade" id="amountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-semibold">
                    <i class="bi bi-pencil-square me-2"></i>Custom amount
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-secondary mb-3">
                    Enter your custom bid amount. Remember it must be at least
                    <strong>$@((Model.CurrentBidPrice + Model.MinimunIncrease).ToString("N2"))</strong>
                </p>
                <div class="input-group">
                    <span class="input-group-text bg-light">$</span>
                    <input type="number" class="form-control" id="customAmount"
                           step="0.01" min="@(Model.CurrentBidPrice + Model.MinimunIncrease)"
                           placeholder="Enter amount">
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="applyCustomAmount">
                    <i class="bi bi-check2 me-1"></i>Apply
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos personalizados */
    .bg-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }

    .input-group-lg .input-group-text {
        font-size: 1.25rem;
    }

    .form-control-lg:focus {
        box-shadow: none;
        border-color: #667eea;
    }

    .btn-outline-primary:hover {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: transparent;
        color: white;
    }

    .btn-outline-primary {
        transition: all 0.3s ease;
    }

    .btn-check:checked + .btn-outline-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: transparent;
        color: white;
    }

    .alert-info {
        background-color: #f0f9ff !important;
    }

    .card {
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.1) !important;
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (() => {
            const currentBid = @Model.CurrentBidPrice;
            const minIncrease = @Model.MinimunIncrease;
            const minRequired = currentBid + minIncrease;

            const amountInput = document.getElementById('amountOffered');
            const suggestedBtn = document.getElementById('suggestedBidBtn');
            const suggestedSpan = document.getElementById('suggestedAmount');
            const validationMessage = document.getElementById('bidValidationMessage');
            const submitBtn = document.getElementById('submitBtn');
            const customAmountBtn = document.getElementById('applyCustomAmount');
            const customAmountInput = document.getElementById('customAmount');

            // Función para validar el monto
            function validateBidAmount(amount) {
                if (!amount || amount < minRequired) {
                    validationMessage.innerHTML = `
                        <div class="text-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            The bid must be at least $${minRequired.toFixed(2)}
                        </div>
                    `;
                    submitBtn.disabled = true;
                    return false;
                } else {
                    validationMessage.innerHTML = `
                        <div class="text-success">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Valid bid amount!
                        </div>
                    `;
                    submitBtn.disabled = false;
                    return true;
                }
            }

            // Validar mientras el usuario escribe
            amountInput.addEventListener('input', (e) => {
                const amount = parseFloat(e.target.value);
                validateBidAmount(amount);
            });

            // Botón de monto sugerido
            suggestedBtn.addEventListener('click', () => {
                amountInput.value = minRequired.toFixed(2);
                validateBidAmount(minRequired);
            });

            // Aplicar monto personalizado del modal
            customAmountBtn.addEventListener('click', () => {
                const amount = parseFloat(customAmountInput.value);
                if (!isNaN(amount) && amount >= minRequired) {
                    amountInput.value = amount.toFixed(2);
                    validateBidAmount(amount);
                    bootstrap.Modal.getInstance(document.getElementById('amountModal')).hide();
                } else {
                    alert(`The amount must be at least $${minRequired.toFixed(2)}`);
                }
            });

            // Validación inicial
            if (amountInput.value) {
                validateBidAmount(parseFloat(amountInput.value));
            } else {
                submitBtn.disabled = true;
            }

            // Validación en el submit del formulario
            document.getElementById('bidForm').addEventListener('submit', (e) => {
                const amount = parseFloat(amountInput.value);
                if (!validateBidAmount(amount)) {
                    e.preventDefault();
                }
            });
        })();
    </script>

}